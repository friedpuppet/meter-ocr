[Unit]
Description=meter-ocr: water-meter photo reading for Home Assistant
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=meter-ocr
Group=meter-ocr
ExecStart=/usr/bin/python /usr/lib/meter-ocr/service.py
Environment=PYTHONUNBUFFERED=1
StateDirectory=meter-ocr
StateDirectoryMode=0700
Restart=on-failure
RestartSec=10
Nice=10
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
